# Copia este archivo a .env y ajusta si hace falta.

API_URL=https://dummyjson.com

# Nombre del ambiente contra el que se corre (Prueba, QA, Pre produccion,
# Staging...). Solo se usa para mostrarlo en el reporte, no cambia ningun
# comportamiento.
AMBIENTE=Pre produccion

# Usuario y clave de prueba para ESTE ambiente. Viven aqui, no en el
# .feature ni en el codigo, porque son datos que pertenecen al ambiente
# (no al caso de prueba): si mañana esto corre contra otro ambiente, solo se
# cambian estas dos lineas y no hay que tocar ningun escenario.
USUARIO_PRUEBA=emilys
CLAVE_PRUEBA=emilyspass
